DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vantara?schema=public"

# Stripe Billing v1: sandbox / TEST MODE ONLY. Never use live credentials.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_LOBBY=""
STRIPE_PRICE_SUITE=""
STRIPE_PRICE_GRAND=""
BILLING_SUCCESS_URL="http://localhost:3000/?billing=returned"
BILLING_CANCEL_URL="http://localhost:3000/?billing=canceled"
BILLING_PORTAL_RETURN_URL="http://localhost:3000/?billing=returned"

# Local development only. Cloud requires NODE_ENV=production, VANTARA_ENV=staging
# or production, exact HTTPS WEB_ORIGIN, and a non-loopback DATABASE_URL.
NODE_ENV="development"
VANTARA_ENV="local"
WEB_ORIGIN="http://localhost:3000"
# Default denied. Enable ONLY for synthetic local onboarding exercises.
ALLOW_LOCAL_WORKSPACE_SIGNUP="false"
